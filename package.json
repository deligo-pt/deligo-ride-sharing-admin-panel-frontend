{
  "name": "deligo-ride-sharing-admin-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "DeliGo Ride Sharing Admin Panel \u2014 frontend prototype with sample data (no backend).",
  "packageManager": "pnpm@11.5.3",
