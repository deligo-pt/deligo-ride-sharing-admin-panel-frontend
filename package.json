    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "exceljs": "4.4.0",
    "lucide-react": "1.51.0",
    "maplibre-gl": "6.12.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "nuqs": "2.10.1",
    "papaparse": "5.7.0",
